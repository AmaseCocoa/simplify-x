{
    "hideCalls": {
        "title": "通話",
        "description": "サイドバーの通話へのリンク",
        "selectors": [
            "a[href=\"/i/calls\"]"
        ]
    },
    "hideCreators": {
        "title": "クリエイタースタジオ",
        "description": "サイドバーのクリエイタースタジオ",
        "selectors": [
            "a[href=\"/i/jf/creators/studio\"]"
        ]
    },
    "hidePremium": {
        "title": "プレミアム関連",
        "description": "登録への案内やサブスクリプションのおすすめ・収益化関連",
        "selectors": [
            "a[href=\"/i/premium_sign_up\"]",
            {
                "i18n": "premiumSubscribe"
            },
            "div:has(> div > a[href=\"/i/premium_sign_up\"])",
            "div:has(> a[href=\"/i/premium_sign_up?referring_page=settings\"])",
            "div:has(> a[href=\"/settings/monetization\"])",
            "a[href=\"/i/verified-choose\"]"
        ]
    },
    "hideGrok": {
        "title": "Grok関連",
        "description": "Grokへのリンクと関連ボタン",
        "selectors": [
            "a[href=\"/i/grok\"]",
            "button[aria-label=\"Grok\"]",
            "button[data-testid=\"grokImgGen\"]",
            "div[role=\"presentation\"]:has(> div > div > button[data-testid=\"grokImgGen\"])",
            {
                "i18n": "grokActions"
            },
            {
                "i18n": "generateImage"
            },
            "a[href^=\"/i/grok-redirect\"]"
        ]
    },
    "hideAds": {
        "title": "広告（トレンド・ポスト・広告リンク）",
        "description": "トレンド広告、イベント広告、ポストの広告、広告サービスへのリンク",
        "selectors": [
            "a[href=\"https://ads.x.com/?ref=gl-tw-tw-twitter-ads-rweb\"]"
        ],
        "scriptSelectors": [
            "[data-testid=\"cellInnerDiv\"]:has([data-testid=\"eventHero\"][data-simplify-x-ad])"
        ],
        "liteDescription": "広告サービスへのリンクのみ。トレンド・イベント・ポスト広告の自動判定はUserScript版で利用できます。"
    },
    "hideVerifiedOrgs": {
        "title": "認証済み組織",
        "description": "認証済み組織への登録リンク",
        "selectors": [
            "a[href=\"/i/verified-orgs-signup\"]"
        ]
    },
    "hideImagine": {
        "title": "Grok Imagine",
        "description": "Grok Imagine関連",
        "selectors": [
            "div:has(> div > div > span):has(> button > div > svg > g > path[d=\"M2.917 12.5l3.75-3.333 2.917 2.916\"])",
            {
                "i18n": "editWithImagine"
            }
        ]
    },
    "hideRecommendedUsers": {
        "title": "おすすめユーザー",
        "description": "右に表示されるおすすめユーザーを非表示にします。",
        "selectors": [
            {
                "i18n": "recommendedUsers"
            }
        ]
    },
    "hideImpression": {
        "title": "インプレッションを非表示",
        "selectors": [
            {
                "i18n": "postViews"
            },
            "a[href*=\"/status/\"][href$=\"/analytics\"]",
            "div:has(> div > div > a[href=\"/i/account_analytics\"])"
        ],
        "description": "ポストの表示回数とアナリティクスへのリンク"
    }
